# Google ADK Service Account Configuration (for Vertex AI/ADK)
# Path to service account JSON key file (relative to python-adk-service directory)
GOOGLE_APPLICATION_CREDENTIALS=../service-account-key.json

# Google Cloud Project Configuration (required for ADK)
GOOGLE_CLOUD_PROJECT_ID=your-project-id-here
GOOGLE_CLOUD_LOCATION=us-central1

# Model Configuration
MODEL_NAME=gemini-2.0-flash-live-001

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=*

# Optional: API Key (for fallback if not using service account)
# GOOGLE_API_KEY=your-api-key-here
